{
  "name": "ahegyes/wp-framework-utilities",
  "description": "Hooks, admin notices, caching, and conditionals for WordPress plugins built on the DWS framework.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/ahegyes/wordpress-framework",
  "authors": [
    {
      "name": "Contributors",
      "homepage": "https://github.com/ahegyes/wordpress-framework/graphs/contributors"
    }
  ],
  "keywords": ["wordpress", "wordpress-plugin", "framework", "hooks", "admin-notices"],
  "support": {
    "issues": "https://github.com/ahegyes/wordpress-framework/issues",
    "source": "https://github.com/ahegyes/wordpress-framework"
  },

  "require": {
    "php": ">=8.5",
    "ahegyes/wp-framework-core": "^2.0@dev",
    "ahegyes/wp-framework-shared": "^2.0@dev",
    "ahegyes/wp-framework-storage": "^2.0@dev",
    "psr/log": "^3"
  },

  "autoload": {
    "psr-4": {
      "DeepWebSolutions\\Framework\\Utilities\\": "src/"
    },
    "files": [
      "functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "DeepWebSolutions\\Framework\\Utilities\\Tests\\": "tests/"
    }
  },

  "extra": {
    "branch-alias": {
      "dev-trunk": "2.0.x-dev"
    },
    "scoping-stubs": [
      "php-stubs/wordpress-stubs",
      "php-stubs/woocommerce-stubs:woocommerce-packages-stubs.php"
    ],
    "changelogger": {
      "versioning": "semver",
      "changelog": "CHANGELOG.md",
      "changes-dir": "changelog",
      "default-type": "changed",
      "types": {
        "added": "Added",
        "changed": "Changed",
        "deprecated": "Deprecated",
        "removed": "Removed",
        "fixed": "Fixed",
        "security": "Security"
      }
    }
  },

  "config": {
    "allow-plugins": {
      "composer/*": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
