{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#tags/7.1.4",
	"phpVersion": "8.6",
	"port": 8805,
	"testsEnvironment": false,
	"mappings": {
		"wp-content/mu-plugins/wp-framework": ".",
		"wp-content/plugins/acme-end-to-end": "./tests/Fixtures/end-to-end",
		"wp-content/plugins/woocommerce": "./vendor/wp-plugin/woocommerce"
	},
	"config": {
		"WP_DEBUG": true,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": false
	},
	"lifecycleScripts": {
		"afterStart": "node_modules/.bin/wp-env --config .wp-env.php86.json run cli wp plugin activate woocommerce && node_modules/.bin/wp-env --config .wp-env.php86.json run cli wp wc hpos enable"
	}
}
