{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "minCoveredMsi": 90,
    "source": {
        "directories": [
            "packages/bootstrap/src",
            "packages/core/src",
            "packages/settings/src",
            "packages/shared/src",
            "packages/storage/src",
            "packages/utilities/src",
            "packages/woocommerce/src"
        ],
        "excludes": [
            "tests",
            "changelog"
        ]
    },
    "logs": {
        "text": "build/infection/infection.log",
        "html": "build/infection/infection.html",
        "summary": "build/infection/summary.log"
    },
    "mutators": {
        "@default": true
    }
}
