{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "minCoveredMsi": 92,
    "source": {
        "directories": [
            "packages/bootstrap/src",
            "packages/core/src",
            "packages/infrastructure/src/Settings",
            "packages/shared/src",
            "packages/infrastructure/src/Storage",
            "packages/infrastructure/src/Utilities",
            "packages/woocommerce/src"
        ],
        "excludes": [
            "tests",
            "changelog"
        ]
    },
    "logs": {
        "text": "build/infection/infection.log",
        "html": "build/infection/infection.html",
        "summary": "build/infection/summary.log"
    },
    "mutators": {
        "@default": true
    }
}
