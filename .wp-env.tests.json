{
    "$schema": "https://schemas.wp.org/trunk/wp-env.schema.json",
    "core": "WordPress/WordPress#tags/7.0",
    "phpVersion": "8.5",
    "port": 8801,
    "testsEnvironment": false,
    "mappings": {
        "wp-content/mu-plugins/wp-framework": ".",
        "wp-content/plugins/dws-framework-test-plugin": "./packages/bootstrap/tests/Fixtures/dws-framework-test-plugin",
        "wp-content/plugins/plugin-header-fixture": "./packages/core/tests/Fixtures/plugin-header-fixture",
        "wp-content/plugins/subdirectory-fixture": "./packages/core/tests/Fixtures/subdirectory-fixture",
        "wp-content/plugins/network-fixture": "./packages/core/tests/Fixtures/network-fixture",
        "wp-content/plugins/dws-single-file-fixture.php": "./packages/core/tests/Fixtures/dws-single-file-fixture.php",
        "wp-content/plugins/woocommerce": "./vendor/wp-plugin/woocommerce"
    },
    "config": {
        "WP_DEBUG": true,
        "SCRIPT_DEBUG": true
    },
    "lifecycleScripts": {
        "afterStart": "node_modules/.bin/wp-env --config .wp-env.tests.json run cli wp plugin activate woocommerce && node_modules/.bin/wp-env --config .wp-env.tests.json run cli wp wc hpos enable"
    }
}
