includes:
    - vendor/ahegyes/wordpress-configs/php/quality-assurance/phpstan.dist.neon

parameters:
    # PHPStan does not expand globs in `paths`; each package is enumerated literally.
    paths:
        - packages/bootstrap/functions.php
        - packages/bootstrap/src
        - packages/bootstrap/tests
        - packages/shared/functions.php
        - packages/shared/src
        - packages/shared/tests
        - packages/storage/functions.php
        - packages/storage/src
        - packages/storage/tests
        - packages/core/functions.php
        - packages/core/src
        - packages/core/tests
        - packages/utilities/functions.php
        - packages/utilities/src
        - packages/utilities/tests
        - packages/woocommerce/functions.php
        - packages/woocommerce/src
        - packages/woocommerce/tests
