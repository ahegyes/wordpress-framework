{
	"name": "@ahegyes/wordpress-framework",
	"private": true,
	"description": "Development tooling for the wp-framework-* WordPress plugin framework monorepo.",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ahegyes/wordpress-framework.git"
	},
	"bugs": "https://github.com/ahegyes/wordpress-framework/issues",
	"engines": {
		"node": ">=26",
		"npm": ">=11"
	},
	"devDependencies": {
		"@ahegyes/wordpress-configs": "git+https://github.com/ahegyes/wordpress-configs.git#c944e73ab2656633397e7736ea104bbe72726ffd",
		"@playwright/test": "^1.64.1",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/scripts": "^37.0.0"
	},
	"scripts": {
		"setup": "npm run packages-install:all && npm run wp-env:start",
		"packages-install:all": "composer packages-install && npm run packages-install",
		"packages-update:all": "composer packages-update && npm run packages-update && npm run packages-update:wp",

		"packages-install": "npm install",
		"packages-update": "npm update",
		"packages-update:wp": "wp-scripts packages-update",

		"format:all": "composer format:php",

		"lint:scripts": "wp-scripts lint-js tests/EndToEnd eslint.config.mjs playwright.config.js",
		"lint:all": "composer lint:php && npm run lint:scripts",

		"wp-env:start": "wp-env start",
		"wp-env:stop": "wp-env stop",
		"wp-env:update": "wp-env start --update",
		"wp-env:destroy": "wp-env destroy",

		"wp-env:tests:start": "wp-env --config .wp-env.tests.json start",
		"wp-env:tests:stop": "wp-env --config .wp-env.tests.json stop",
		"wp-env:tests:update": "wp-env --config .wp-env.tests.json start --update",
		"wp-env:tests:destroy": "wp-env --config .wp-env.tests.json destroy",

		"wp-env:multisite:start": "wp-env --config .wp-env.multisite.json start",
		"wp-env:multisite:stop": "wp-env --config .wp-env.multisite.json stop",
		"wp-env:multisite:update": "wp-env --config .wp-env.multisite.json start --update",
		"wp-env:multisite:destroy": "wp-env --config .wp-env.multisite.json destroy",

		"wp-env:php74:start": "wp-env --config .wp-env.php74.json start",
		"wp-env:php74:stop": "wp-env --config .wp-env.php74.json stop",
		"wp-env:php74:update": "wp-env --config .wp-env.php74.json start --update",
		"wp-env:php74:destroy": "wp-env --config .wp-env.php74.json destroy",

		"wp-env:php86:start": "wp-env --config .wp-env.php86.json start",
		"wp-env:php86:stop": "wp-env --config .wp-env.php86.json stop",
		"wp-env:php86:update": "wp-env --config .wp-env.php86.json start --update",
		"wp-env:php86:destroy": "wp-env --config .wp-env.php86.json destroy",

		"wp-env:woocommerce-nightly:start": "wp-env --config .wp-env.woocommerce-nightly.json start",
		"wp-env:woocommerce-nightly:stop": "wp-env --config .wp-env.woocommerce-nightly.json stop",
		"wp-env:woocommerce-nightly:update": "wp-env --config .wp-env.woocommerce-nightly.json start --update",
		"wp-env:woocommerce-nightly:destroy": "wp-env --config .wp-env.woocommerce-nightly.json destroy",

		"audit": "composer audit --locked --abandoned=report && npm audit --omit=dev --audit-level=high",
		"audit:fix": "npm audit fix",
		"check:engines": "wp-scripts check-engines",
		"check:licenses": "wp-scripts check-licenses",

		"test:e2e": "playwright test --config=playwright.config.js",
		"test:e2e:php86": "npm run wp-env:php86:start && WP_BASE_URL=http://localhost:8805 playwright test --config=playwright.config.js",
		"test:all": "composer test && npm run test:e2e",

		"quality-check:all": "composer quality-check && npm run lint:scripts && npm run test:e2e"
	}
}
