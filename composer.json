{
  "name": "ahegyes/wordpress-framework",
  "description": "DWS WordPress Framework v2 — monorepo development root. Aggregates bootstrap, core, utilities, and woocommerce packages for local dev and cross-package testing.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/ahegyes/wordpress-framework",
  "authors": [
    {
      "name": "Contributors",
      "homepage": "https://github.com/ahegyes/wordpress-framework/graphs/contributors"
    }
  ],

  "require": {
    "php": ">=8.5",
    "ahegyes/wp-framework-bootstrap": "^2.0@dev",
    "ahegyes/wp-framework-core": "^2.0@dev"
  },
  "require-dev": {
    "ahegyes/wordpress-configs": "dev-trunk",
    "deptrac/deptrac": "^4.6",
    "infection/infection": "^0.32",
    "johnpbloch/wordpress-core": "^7.0@dev",
    "phpunit/phpunit": "^13"
  },

  "repositories": [
    {
      "type": "path",
      "url": "packages/bootstrap",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "packages/core",
      "options": { "symlink": true }
    },
    {
      "type": "vcs",
      "url": "https://github.com/ahegyes/wordpress-configs"
    }
  ],

  "minimum-stability": "dev",
  "prefer-stable": true,

  "scripts": {
    "generate-autoloader": "@composer dump-autoload --ignore-platform-reqs -o",

    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "@php vendor/bin/phpunit --testsuite=Unit",
    "test:integration": "npm --prefix=. run test:integration",
    "test:mutation": "@php vendor/bin/infection --threads=max",
    "test:all": [
      "@test:unit",
      "@test:integration",
      "@test:mutation"
    ],

    "format:php": "phpcbf --standard=./phpcs.xml --basepath=. ./ -v",
    "lint:php": [
      "@lint:php:phpcs",
      "@lint:php:phpstan",
      "@lint:php:deptrac"
    ],
    "lint:php:phpcs": "phpcs --standard=./phpcs.xml --basepath=. ./ -v",
    "lint:php:phpstan": "phpstan analyse -c ./phpstan.neon -v --memory-limit=1G",
    "lint:php:deptrac": "deptrac analyse --no-interaction",

    "quality-check": [
      "@lint:php",
      "@test:unit"
    ],
    "quality-check:all": [
      "@lint:php",
      "@test:all"
    ],

    "packages-install": "@composer install --ignore-platform-reqs --no-interaction",
    "packages-update": [
      "@composer clear-cache",
      "@composer update --prefer-stable --ignore-platform-reqs --no-interaction"
    ]
  },

  "config": {
    "allow-plugins": {
      "composer/*": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
