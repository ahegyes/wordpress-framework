{
  "name": "ahegyes/wordpress-framework",
  "description": "DWS WordPress Framework — monorepo development root. Aggregates bootstrap, shared, storage, core, utilities, settings, and woocommerce packages for local dev and cross-package testing.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/ahegyes/wordpress-framework",
  "authors": [
    {
      "name": "Contributors",
      "homepage": "https://github.com/ahegyes/wordpress-framework/graphs/contributors"
    }
  ],

  "require": {
    "php": ">=8.5",
    "ahegyes/wp-framework-bootstrap": "^2.0@dev",
    "ahegyes/wp-framework-core": "^2.0@dev",
    "ahegyes/wp-framework-settings": "^2.0@dev",
    "ahegyes/wp-framework-shared": "^2.0@dev",
    "ahegyes/wp-framework-storage": "^2.0@dev",
    "ahegyes/wp-framework-utilities": "^2.0@dev",
    "ahegyes/wp-framework-woocommerce": "^2.0@dev"
  },
  "require-dev": {
    "ahegyes/wordpress-configs": "dev-trunk",
    "automattic/jetpack-changelogger": "^6.0",
    "deptrac/deptrac": "^4.6",
    "infection/infection": "^0.32",
    "johnpbloch/wordpress-core": "^7.0",
    "php-stubs/woocommerce-stubs": "^10.9",
    "php-stubs/wordpress-stubs": "7.0.0 as 6.9999.0",
    "phpunit/phpunit": "^13",
    "wp-plugin/woocommerce": "^10.9"
  },

  "repositories": [
    {
      "type": "path",
      "url": "packages/bootstrap",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "packages/core",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "packages/settings",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "packages/shared",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "packages/storage",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "packages/utilities",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "packages/woocommerce",
      "options": { "symlink": true }
    },
    {
      "type": "vcs",
      "url": "https://github.com/ahegyes/wordpress-configs"
    },
    {
      "type": "composer",
      "url": "https://repo.wp-packages.org",
      "only": ["wp-plugin/*", "wp-theme/*"]
    }
  ],

  "minimum-stability": "dev",
  "prefer-stable": true,

  "autoload-dev": {
    "psr-4": {
      "DeepWebSolutions\\Framework\\Bootstrap\\Tests\\": "packages/bootstrap/tests/",
      "DeepWebSolutions\\Framework\\Core\\Tests\\": "packages/core/tests/",
      "DeepWebSolutions\\Framework\\Settings\\Tests\\": "packages/settings/tests/",
      "DeepWebSolutions\\Framework\\Shared\\Tests\\": "packages/shared/tests/",
      "DeepWebSolutions\\Framework\\Storage\\Tests\\": "packages/storage/tests/",
      "DeepWebSolutions\\Framework\\Utilities\\Tests\\": "packages/utilities/tests/",
      "DeepWebSolutions\\Framework\\WooCommerce\\Tests\\": "packages/woocommerce/tests/"
    }
  },

  "scripts": {
    "generate-autoloader": "@composer dump-autoload --ignore-platform-reqs -o",
    "packages-install": "@composer install --ignore-platform-reqs --no-interaction",
    "packages-update": [
      "@composer clear-cache",
      "@composer update --prefer-stable --ignore-platform-reqs --no-interaction"
    ],

    "format:php": "phpcbf --standard=./phpcs.dist.xml --basepath=. ./ -v",
    "lint:php": [
      "@lint:php:phpcs",
      "@lint:php:phpstan",
      "@lint:php:deptrac"
    ],
    "lint:php:phpcs": "phpcs --standard=./phpcs.dist.xml --basepath=. ./ -v",
    "lint:php:phpstan": "phpstan analyse -v --memory-limit=1G",
    "lint:php:deptrac": "deptrac analyse --no-interaction --cache-file=tests/.cache/deptrac",

    "test:wp-env:ensure": "node_modules/.bin/wp-env --config .wp-env.tests.json run cli true >/dev/null 2>&1 || npm --prefix=. run wp-env:start",
    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "@php vendor/bin/phpunit --testsuite=Unit",
    "test:integration": [
      "@putenv CI=1",
      "@test:wp-env:ensure",
      "node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/mu-plugins/wp-framework vendor/bin/phpunit --testsuite=Integration"
    ],
    "test:mutation": "@php vendor/bin/infection --threads=max",
    "test:all": [
      "@test:unit",
      "@test:integration",
      "@test:mutation"
    ],

    "quality-check": [
      "@lint:php",
      "@test"
    ],
    "quality-check:all": [
      "@lint:php",
      "@test:all"
    ],

    "packages:bootstrap:test": [
      "@packages:bootstrap:test:unit",
      "@packages:bootstrap:test:integration"
    ],
    "packages:bootstrap:test:unit": "@php vendor/bin/phpunit packages/bootstrap/tests/Unit",
    "packages:bootstrap:test:integration": [
      "@putenv CI=1",
      "@test:wp-env:ensure",
      "node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/mu-plugins/wp-framework vendor/bin/phpunit packages/bootstrap/tests/Integration"
    ],
    "packages:bootstrap:changelog:add": "cd packages/bootstrap && ../../vendor/bin/changelogger add",
    "packages:bootstrap:changelog:validate": "cd packages/bootstrap && ../../vendor/bin/changelogger validate",
    "packages:bootstrap:changelog:write": "cd packages/bootstrap && ../../vendor/bin/changelogger write",

    "packages:core:test": [
      "@packages:core:test:unit",
      "@packages:core:test:integration"
    ],
    "packages:core:test:unit": "@php vendor/bin/phpunit packages/core/tests/Unit",
    "packages:core:test:integration": [
      "@putenv CI=1",
      "@test:wp-env:ensure",
      "node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/mu-plugins/wp-framework vendor/bin/phpunit packages/core/tests/Integration"
    ],
    "packages:core:changelog:add": "cd packages/core && ../../vendor/bin/changelogger add",
    "packages:core:changelog:validate": "cd packages/core && ../../vendor/bin/changelogger validate",
    "packages:core:changelog:write": "cd packages/core && ../../vendor/bin/changelogger write",

    "packages:settings:test": [
      "@packages:settings:test:unit",
      "@packages:settings:test:integration"
    ],
    "packages:settings:test:unit": "@php vendor/bin/phpunit packages/settings/tests/Unit",
    "packages:settings:test:integration": [
      "@putenv CI=1",
      "@test:wp-env:ensure",
      "node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/mu-plugins/wp-framework vendor/bin/phpunit packages/settings/tests/Integration"
    ],
    "packages:settings:changelog:add": "cd packages/settings && ../../vendor/bin/changelogger add",
    "packages:settings:changelog:validate": "cd packages/settings && ../../vendor/bin/changelogger validate",
    "packages:settings:changelog:write": "cd packages/settings && ../../vendor/bin/changelogger write",

    "packages:shared:test": [
      "@packages:shared:test:unit",
      "@packages:shared:test:integration"
    ],
    "packages:shared:test:unit": "@php vendor/bin/phpunit packages/shared/tests/Unit",
    "packages:shared:test:integration": [
      "@putenv CI=1",
      "@test:wp-env:ensure",
      "node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/mu-plugins/wp-framework vendor/bin/phpunit packages/shared/tests/Integration"
    ],
    "packages:shared:changelog:add": "cd packages/shared && ../../vendor/bin/changelogger add",
    "packages:shared:changelog:validate": "cd packages/shared && ../../vendor/bin/changelogger validate",
    "packages:shared:changelog:write": "cd packages/shared && ../../vendor/bin/changelogger write",

    "packages:storage:test": [
      "@packages:storage:test:unit",
      "@packages:storage:test:integration"
    ],
    "packages:storage:test:unit": "@php vendor/bin/phpunit packages/storage/tests/Unit",
    "packages:storage:test:integration": [
      "@putenv CI=1",
      "@test:wp-env:ensure",
      "node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/mu-plugins/wp-framework vendor/bin/phpunit packages/storage/tests/Integration"
    ],
    "packages:storage:changelog:add": "cd packages/storage && ../../vendor/bin/changelogger add",
    "packages:storage:changelog:validate": "cd packages/storage && ../../vendor/bin/changelogger validate",
    "packages:storage:changelog:write": "cd packages/storage && ../../vendor/bin/changelogger write",

    "packages:utilities:test": [
      "@packages:utilities:test:unit",
      "@packages:utilities:test:integration"
    ],
    "packages:utilities:test:unit": "@php vendor/bin/phpunit packages/utilities/tests/Unit",
    "packages:utilities:test:integration": [
      "@putenv CI=1",
      "@test:wp-env:ensure",
      "node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/mu-plugins/wp-framework vendor/bin/phpunit packages/utilities/tests/Integration"
    ],
    "packages:utilities:changelog:add": "cd packages/utilities && ../../vendor/bin/changelogger add",
    "packages:utilities:changelog:validate": "cd packages/utilities && ../../vendor/bin/changelogger validate",
    "packages:utilities:changelog:write": "cd packages/utilities && ../../vendor/bin/changelogger write",

    "packages:woocommerce:test": [
      "@packages:woocommerce:test:unit",
      "@packages:woocommerce:test:integration"
    ],
    "packages:woocommerce:test:unit": "@php vendor/bin/phpunit packages/woocommerce/tests/Unit",
    "packages:woocommerce:test:integration": [
      "@putenv CI=1",
      "@test:wp-env:ensure",
      "node_modules/.bin/wp-env --config .wp-env.tests.json run cli --env-cwd=wp-content/mu-plugins/wp-framework vendor/bin/phpunit packages/woocommerce/tests/Integration"
    ],
    "packages:woocommerce:changelog:add": "cd packages/woocommerce && ../../vendor/bin/changelogger add",
    "packages:woocommerce:changelog:validate": "cd packages/woocommerce && ../../vendor/bin/changelogger validate",
    "packages:woocommerce:changelog:write": "cd packages/woocommerce && ../../vendor/bin/changelogger write",

    "packages:changelog:validate": [
      "@packages:bootstrap:changelog:validate",
      "@packages:core:changelog:validate",
      "@packages:settings:changelog:validate",
      "@packages:shared:changelog:validate",
      "@packages:storage:changelog:validate",
      "@packages:utilities:changelog:validate",
      "@packages:woocommerce:changelog:validate"
    ],
    "packages:changelog:write": [
      "@packages:bootstrap:changelog:write",
      "@packages:core:changelog:write",
      "@packages:settings:changelog:write",
      "@packages:shared:changelog:write",
      "@packages:storage:changelog:write",
      "@packages:utilities:changelog:write",
      "@packages:woocommerce:changelog:write"
    ],

    "changelog:validate": "@packages:changelog:validate",

    "changelog:add:bootstrap": "@packages:bootstrap:changelog:add",
    "changelog:add:core": "@packages:core:changelog:add",
    "changelog:add:settings": "@packages:settings:changelog:add",
    "changelog:add:shared": "@packages:shared:changelog:add",
    "changelog:add:storage": "@packages:storage:changelog:add",
    "changelog:add:utilities": "@packages:utilities:changelog:add",
    "changelog:add:woocommerce": "@packages:woocommerce:changelog:add",

    "changelog:write:bootstrap": "@packages:bootstrap:changelog:write",
    "changelog:write:core": "@packages:core:changelog:write",
    "changelog:write:settings": "@packages:settings:changelog:write",
    "changelog:write:shared": "@packages:shared:changelog:write",
    "changelog:write:storage": "@packages:storage:changelog:write",
    "changelog:write:utilities": "@packages:utilities:changelog:write",
    "changelog:write:woocommerce": "@packages:woocommerce:changelog:write"
  },

  "extra": {
    "installer-paths": {
      "vendor/{$vendor}/{$name}/": [
        "type:wordpress-plugin",
        "type:wordpress-theme"
      ]
    }
  },

  "config": {
    "allow-plugins": {
      "composer/*": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
