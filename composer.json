{
  "name": "ahegyes/wordpress-framework",
  "description": "DWS WordPress Framework — monorepo development root. Aggregates bootstrap, core, utilities, and woocommerce packages for local dev and cross-package testing.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/ahegyes/wordpress-framework",
  "authors": [
    {
      "name": "Contributors",
      "homepage": "https://github.com/ahegyes/wordpress-framework/graphs/contributors"
    }
  ],

  "require": {
    "php": ">=8.5",
    "ahegyes/wp-framework-bootstrap": "^2.0@dev",
    "ahegyes/wp-framework-core": "^2.0@dev",
    "ahegyes/wp-framework-utilities": "^2.0@dev",
    "ahegyes/wp-framework-woocommerce": "^2.0@dev"
  },
  "require-dev": {
    "ahegyes/wordpress-configs": "dev-trunk",
    "automattic/jetpack-changelogger": "^6.0",
    "deptrac/deptrac": "^4.6",
    "infection/infection": "^0.32",
    "johnpbloch/wordpress-core": "^7.0@dev",
    "phpunit/phpunit": "^13",
    "wp-plugin/woocommerce": "*"
  },

  "repositories": [
    {
      "type": "path",
      "url": "packages/bootstrap",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "packages/core",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "packages/utilities",
      "options": { "symlink": true }
    },
    {
      "type": "path",
      "url": "packages/woocommerce",
      "options": { "symlink": true }
    },
    {
      "type": "vcs",
      "url": "https://github.com/ahegyes/wordpress-configs"
    },
    {
      "type": "composer",
      "url": "https://repo.wp-packages.org",
      "only": ["wp-plugin/*", "wp-theme/*"]
    }
  ],

  "minimum-stability": "dev",
  "prefer-stable": true,

  "scripts": {
    "generate-autoloader": "@composer dump-autoload --ignore-platform-reqs -o",
    "packages-install": "@composer install --ignore-platform-reqs --no-interaction",
    "packages-update": [
      "@composer clear-cache",
      "@composer update --prefer-stable --ignore-platform-reqs --no-interaction"
    ],

    "format:php": "phpcbf --standard=./phpcs.dist.xml --basepath=. ./ -v",
    "lint:php": [
      "@lint:php:phpcs",
      "@lint:php:phpstan",
      "@lint:php:deptrac"
    ],
    "lint:php:phpcs": "phpcs --standard=./phpcs.dist.xml --basepath=. ./ -v",
    "lint:php:phpstan": "phpstan analyse -v --memory-limit=1G",
    "lint:php:deptrac": "deptrac analyse --no-interaction",

    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "@php vendor/bin/phpunit --testsuite=Unit",
    "test:integration": "npm --prefix=. run test:integration",
    "test:mutation": "@php vendor/bin/infection --threads=max",
    "test:all": [
      "@test:unit",
      "@test:integration",
      "@test:mutation"
    ],

    "quality-check": [
      "@lint:php",
      "@test:unit"
    ],
    "quality-check:all": [
      "@lint:php",
      "@test:all"
    ],

    "changelog:add:bootstrap": "cd packages/bootstrap && ../../vendor/bin/changelogger add",
    "changelog:add:core": "cd packages/core && ../../vendor/bin/changelogger add",
    "changelog:add:utilities": "cd packages/utilities && ../../vendor/bin/changelogger add",
    "changelog:add:woocommerce": "cd packages/woocommerce && ../../vendor/bin/changelogger add",
    "changelog:validate": [
      "@changelog:validate:bootstrap",
      "@changelog:validate:core",
      "@changelog:validate:utilities",
      "@changelog:validate:woocommerce"
    ],
    "changelog:validate:bootstrap": "cd packages/bootstrap && ../../vendor/bin/changelogger validate",
    "changelog:validate:core": "cd packages/core && ../../vendor/bin/changelogger validate",
    "changelog:validate:utilities": "cd packages/utilities && ../../vendor/bin/changelogger validate",
    "changelog:validate:woocommerce": "cd packages/woocommerce && ../../vendor/bin/changelogger validate",
    "changelog:write:bootstrap": "cd packages/bootstrap && ../../vendor/bin/changelogger write",
    "changelog:write:core": "cd packages/core && ../../vendor/bin/changelogger write",
    "changelog:write:utilities": "cd packages/utilities && ../../vendor/bin/changelogger write",
    "changelog:write:woocommerce": "cd packages/woocommerce && ../../vendor/bin/changelogger write"
  },

  "extra": {
    "installer-paths": {
      "vendor/{$vendor}/{$name}/": [
        "type:wordpress-plugin",
        "type:wordpress-theme"
      ]
    }
  },

  "config": {
    "allow-plugins": {
      "composer/*": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
