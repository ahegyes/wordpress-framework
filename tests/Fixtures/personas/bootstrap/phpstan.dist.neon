# The plugin runs on PHP 7.4 and WordPress 5.8, so it is analyzed there; the WordPress extensions are listed here because composer.json keeps them from installing themselves, and before configs' profile because wp-compat's neon resets WPCompat.requiresAtLeast to null.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - vendor/johnbillion/wp-compat/extension.neon
    - vendor/swissspidy/phpstan-no-private/rules.neon
    - vendor/ahegyes/wordpress-configs/php/quality-assurance/phpstan.dist.neon

parameters:
    paths:
        - acme-persona-bootstrap.php
        - functions.php
    phpVersion: 70400
    WPCompat:
        requiresAtLeast: '5.8'
    # The bootstrap package loads by path, from vendor-prefixed/, which PHPStan does not read.
    scanDirectories:
        - vendor-prefixed
