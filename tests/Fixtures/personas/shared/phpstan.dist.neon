# WordPress-free: only configs' base is included, and composer.json keeps the WordPress extensions from installing themselves.
includes:
    - vendor/ahegyes/wordpress-configs/php/quality-assurance/phpstan.base.dist.neon

parameters:
    paths:
        - run.php
        - src
    # The scoped package loads through vendor-prefixed/scoper-autoload.php, which PHPStan does not read.
    scanDirectories:
        - vendor-prefixed
