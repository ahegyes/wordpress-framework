# The bootstrap package runs before any floor is checked, so it is analyzed at the oldest PHP and WordPress it supports; the WordPress extensions are listed because composer.json keeps them from installing themselves.
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - vendor/johnbillion/wp-compat/extension.neon
    - vendor/swissspidy/phpstan-no-private/rules.neon
    - vendor/ahegyes/wordpress-configs/php/quality-assurance/phpstan.dist.neon

parameters:
    paths:
        - packages/bootstrap
    phpVersion: 70400
    WPCompat:
        requiresAtLeast: '5.2'
