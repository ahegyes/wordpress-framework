# The WordPress extensions are listed here because composer.json keeps them from installing themselves.
includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	- vendor/johnbillion/wp-compat/extension.neon
	- vendor/swissspidy/phpstan-no-private/rules.neon
	- vendor/ahegyes/wordpress-configs/php/quality-assurance/phpstan.dist.neon

parameters:
	paths:
		- packages/bootstrap
		- tests/Fixtures/consumer-a/Safeguards.php
	# The bootstrap package and consumer-a's safeguards run before any floor is checked, so they are analyzed at the oldest PHP and WordPress the bootstrap package runs on.
	phpVersion: 70400
	WPCompat:
		requiresAtLeast: '5.2'
