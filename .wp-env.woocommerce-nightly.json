{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#tags/7.1.4",
	"phpVersion": "8.5",
	"port": 8804,
	"testsEnvironment": false,
	"mappings": {
		"wp-content/mu-plugins/wp-framework": ".",
		"wp-content/plugins/acme-end-to-end": "./tests/Fixtures/end-to-end",
		"wp-content/plugins/woocommerce": "https://github.com/woocommerce/woocommerce/releases/download/nightly/woocommerce-trunk-nightly.zip"
	},
	"config": {
		"WP_DEBUG": true,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": false
	},
	"lifecycleScripts": {
		"afterStart": "node_modules/.bin/wp-env --config .wp-env.woocommerce-nightly.json run cli wp plugin activate woocommerce && node_modules/.bin/wp-env --config .wp-env.woocommerce-nightly.json run cli wp wc hpos enable"
	}
}
